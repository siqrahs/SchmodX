<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com"
    xmlns:tools="http://android.com">

    <!-- Izin dasar membaca plugin dari folder internal aplikasi -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Chmods"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        tools:targetApi="34">
        
        <!-- Jalur nama aktivitas utama wajib menggunakan nama paket absolut -->
        <activity
            android:name="com.chmods.MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Provider interkoneksi Shizuku API -->
        <provider
            android:name="moe.shizuku.api.ShizukuBinderReceiveProvider"
            android:authorities="com.chmods.shizuku"
            android:exported="true"
            android:enabled="true"
            android:multiprocess="false"
            tools:replace="android:authorities" />

    </application>

</manifest>
