<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com"
    xmlns:tools="http://android.com">

    <!-- Izin dasar untuk membaca file APK plugin dari penyimpanan internal aplikasi -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Izin internet (opsional, berguna jika Dashboard/Plugin butuh akses jaringan seperti WA Web) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Chmods"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        tools:targetApi="34">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ================= PENTING: INTEGRASI SHIZUKU API ================= -->
        <!-- Provider ini wajib ada agar modul Shizuku di dalam kode Anda bisa mengenali -->
        <!-- binder token dan terhubung ke latar belakang sistem ADB Shell secara aman. -->
        <provider
            android:name="moe.shizuku.api.ShizukuBinderReceiveProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:enabled="true"
            android:multiprocess="false"
            tools:replace="android:authorities" />

    </application>

</manifest>
